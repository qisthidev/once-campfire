# Rails Environment
RAILS_ENV=production
RAILS_MASTER_KEY=your_master_key_here

# Database Configuration
DATABASE_URL=sqlite3:storage/db/production.sqlite3

# Redis Configuration
REDIS_URL=redis://redis:6379/0

# Application Configuration
HTTP_IDLE_TIMEOUT=60
HTTP_READ_TIMEOUT=300
HTTP_WRITE_TIMEOUT=300

# Optional: Sentry Configuration (if using error tracking)
# SENTRY_DSN=your_sentry_dsn_here

# Optional: Web Push Configuration
# WEB_PUSH_PUBLIC_KEY=your_public_key_here
# WEB_PUSH_PRIVATE_KEY=your_private_key_here

# Optional: App Version and Git Revision (for production builds)
# APP_VERSION=1.0.0
# GIT_REVISION=abc123